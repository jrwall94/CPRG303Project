{
  "expo": {
    "name": "goop",
    "slug": "goop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "", //TODO: Insert icon
    "scheme": "goop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "", //TODO: Insert icon
        "backgroundImage": "", //TODO: Insert icon
        "monochromeImage": "" //TODO: Insert icon
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "" //TODO: Insert icon
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
